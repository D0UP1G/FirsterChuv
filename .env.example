# Локальная разработка: скопируйте в .env и замените значения по инструкции.
DJANGO_SECRET_KEY=replace-before-sharing
DJANGO_DEBUG=true
DJANGO_REQUIRE_SECRET_KEY=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
SQLITE_PATH=.data/db.sqlite3
SQLITE_TIMEOUT=5
